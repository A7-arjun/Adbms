(2, 'Amit', 'DBMS', 75, 3, 2026),
(3, 'Priya', 'Python', 90, 3, 2026),
(4, 'Sneha', 'Python', 80, 4, 2026),
(5, 'Rohan', 'DBMS', 65, 4, 2025),
(6, 'Neha', 'Python', 95, 4, 2025);


-- (A) Display all student result records

SELECT * FROM STUDENT_RESULT;


-- (B) Calculate average marks

SELECT AVG(Marks) AS Average_Marks
FROM STUDENT_RESULT;


-- (C) Calculate subject-wise average marks

SELECT
    Subject,
    AVG(Marks) AS Average_Marks
FROM STUDENT_RESULT
GROUP BY Subject;


-- =====================================================
-- ADDITIONAL OLAP PRACTICE QUERIES
-- =====================================================


-- 1. ROLL-UP
-- Calculate average marks semester-wise

SELECT
    Semester,
    AVG(Marks) AS Average_Marks
FROM STUDENT_RESULT
GROUP BY Semester;


-- 2. SLICE
-- Display records for semester 3 only

SELECT *
FROM STUDENT_RESULT
WHERE Semester = 3;


-- 3. DICE
-- Display DBMS marks for semester 3
-- where marks are greater than 80

SELECT *
FROM STUDENT_RESULT
WHERE Subject = 'DBMS'
AND Semester = 3
AND Marks > 80;


-- 4. DRILL-DOWN
-- Show average marks by year, semester and subject

SELECT
    Exam_Year,
    Semester,
    Subject,
    AVG(Marks) AS Average_Marks
FROM STUDENT_RESULT
GROUP BY Exam_Year, Semester, Subject
ORDER BY Exam_Year, Semester, Subject;


-- 5. PIVOT
-- Show subject-wise marks averages
-- in separate semester columns

SELECT
    Subject,

    AVG(CASE
        WHEN Semester = 3 THEN Marks
    END) AS Semester_3,

    AVG(CASE
        WHEN Semester = 4 THEN Marks
    END) AS Semester_4

FROM STUDENT_RESULT
GROUP BY Subject;


