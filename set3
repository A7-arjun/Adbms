-- =====================================================
-- Q6: OLAP - STUDENT_RESULT TABLE
-- =====================================================


DROP TABLE IF EXISTS STUDENT_RESULT;


-- Required question columns
-- Exam_Year is an additional column for OLAP practice

CREATE TABLE STUDENT_RESULT (
    Student_ID INT,
    Student_Name VARCHAR(50),
    Subject VARCHAR(50),
    Marks INT,
    Semester INT,
    Exam_Year INT
);


-- Insert sample records

INSERT INTO STUDENT_RESULT VALUES
