-- Q6: OLAP OPERATIONS
-- SALES TABLE
-- =====================================================


DROP TABLE IF EXISTS SALES;


-- Create SALES table

CREATE TABLE SALES (
    Sale_ID INT PRIMARY KEY,
    Product_Name VARCHAR(50),
    Quantity INT,
    Amount DECIMAL(10,2)
);


-- Insert sales records

INSERT INTO SALES VALUES
(1, 'Mobile', 2, 30000),
(2, 'Laptop', 1, 50000),
(3, 'Mobile', 1, 15000),
(4, 'Headphones', 3, 6000),
(5, 'Laptop', 2, 100000),
(6, 'Headphones', 2, 4000);


-- (A) Display all sales records

SELECT * FROM SALES;


-- (B) Calculate total sales amount

SELECT SUM(Amount) AS Total_Sales
FROM SALES;


-- (C) Display product-wise total sales

SELECT
    Product_Name,
    SUM(Amount) AS Total_Sales
FROM SALES
GROUP BY Product_Name;


-- Additional OLAP-style analysis:
-- Display quantity sold product-wise

SELECT
    Product_Name,
    SUM(Quantity) AS Total_Quantity
FROM SALES
GROUP BY Product_Name;


