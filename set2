-- Q6: OLAP OPERATIONS
-- ORDERS TABLE
-- =====================================================


DROP TABLE IF EXISTS ORDERS;


-- Create ORDERS table

CREATE TABLE ORDERS (
    Order_ID INT PRIMARY KEY,
    Product_Name VARCHAR(50),
    Customer_Name VARCHAR(50),
    Quantity INT,
    Total_Amount DECIMAL(10,2)
);


-- Insert order records

INSERT INTO ORDERS VALUES
(1, 'Mobile', 'Rahul', 2, 30000),
(2, 'Laptop', 'Amit', 1, 50000),
(3, 'Mobile', 'Priya', 1, 15000),
(4, 'Headphones', 'Sneha', 3, 6000),
(5, 'Laptop', 'Rohan', 2, 100000),
(6, 'Headphones', 'Neha', 2, 4000);


-- (A) Display all order records

SELECT * FROM ORDERS;


-- (B) Calculate total order amount

SELECT SUM(Total_Amount) AS Total_Order_Amount
FROM ORDERS;


-- (C) Display product-wise total order amount

SELECT
    Product_Name,
    SUM(Total_Amount) AS Total_Order_Amount
FROM ORDERS
GROUP BY Product_Name;


-- Additional OLAP query:
-- Display total quantity product-wise

SELECT
    Product_Name,
    SUM(Quantity) AS Total_Quantity
FROM ORDERS
GROUP BY Product_Name;


