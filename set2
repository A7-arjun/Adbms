JOIN Dim_Publisher
ON Dim_Book_Snowflake.Publisher_ID =
   Dim_Publisher.Publisher_ID

JOIN Dim_Member_Snowflake
ON Fact_Borrowing_Snowflake.Member_ID =
   Dim_Member_Snowflake.Member_ID

JOIN Dim_City
ON Dim_Member_Snowflake.City_ID =
   Dim_City.City_ID

JOIN Dim_Date_Snowflake
ON Fact_Borrowing_Snowflake.Date_ID =
   Dim_Date_Snowflake.Date_ID;



