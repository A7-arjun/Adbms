-- Retrieve complete borrowing information

SELECT
    Fact_Borrowing_Snowflake.Borrow_ID,
    Dim_Book_Snowflake.Book_Title,
    Dim_Category.Category_Name,
    Dim_Publisher.Publisher_Name,
    Dim_Member_Snowflake.Member_Name,
