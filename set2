-- Q5 (B): SNOWFLAKE SCHEMA
-- SAME LIBRARY DATABASE EXAMPLE
-- =====================================================


-- Drop old Snowflake tables in dependency order

DROP TABLE IF EXISTS Fact_Borrowing_Snowflake;
DROP TABLE IF EXISTS Dim_Book_Snowflake;
DROP TABLE IF EXISTS Dim_Category;
DROP TABLE IF EXISTS Dim_Publisher;
DROP TABLE IF EXISTS Dim_Member_Snowflake;
DROP TABLE IF EXISTS Dim_City;
DROP TABLE IF EXISTS Dim_Date_Snowflake;


-- Sub-dimension: Book category

CREATE TABLE Dim_Category (
    Category_ID INT PRIMARY KEY,
    Category_Name VARCHAR(50)
);


-- Sub-dimension: Publisher

CREATE TABLE Dim_Publisher (
    Publisher_ID INT PRIMARY KEY,
    Publisher_Name VARCHAR(50)
);


-- Sub-dimension: City

CREATE TABLE Dim_City (
    City_ID INT PRIMARY KEY,
    City_Name VARCHAR(50)
);


-- Main dimension: Book

CREATE TABLE Dim_Book_Snowflake (
    Book_ID INT PRIMARY KEY,
    Book_Title VARCHAR(50),
    Category_ID INT,
    Publisher_ID INT,

    FOREIGN KEY (Category_ID)
    REFERENCES Dim_Category(Category_ID),

    FOREIGN KEY (Publisher_ID)
    REFERENCES Dim_Publisher(Publisher_ID)
);


-- Main dimension: Member

CREATE TABLE Dim_Member_Snowflake (
    Member_ID INT PRIMARY KEY,
    Member_Name VARCHAR(50),
    City_ID INT,

    FOREIGN KEY (City_ID)
    REFERENCES Dim_City(City_ID)
);


-- Dimension: Date

CREATE TABLE Dim_Date_Snowflake (
    Date_ID INT PRIMARY KEY,
    Borrow_Date DATE,
    Month_Name VARCHAR(20),
    Borrow_Year INT
);


-- Central Fact Table

CREATE TABLE Fact_Borrowing_Snowflake (
    Borrow_ID INT PRIMARY KEY,
    Book_ID INT,
    Member_ID INT,
    Date_ID INT,
    Quantity INT,
    Fine_Amount DECIMAL(10,2),

    FOREIGN KEY (Book_ID)
    REFERENCES Dim_Book_Snowflake(Book_ID),

    FOREIGN KEY (Member_ID)
    REFERENCES Dim_Member_Snowflake(Member_ID),

    FOREIGN KEY (Date_ID)
    REFERENCES Dim_Date_Snowflake(Date_ID)
);


