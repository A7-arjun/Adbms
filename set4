-- Display fact table

SELECT * FROM Fact_Sales_Snowflake;


-- Retrieve complete sales information

SELECT
    Fact_Sales_Snowflake.Sale_ID,
    Dim_Product_Snowflake.Product_Name,
    Dim_Category.Category_Name,
    Dim_Brand.Brand_Name,
    Dim_Customer_Snowflake.Customer_Name,
    Dim_City.City_Name,
    Dim_Date_Snowflake.Sale_Date,
    Fact_Sales_Snowflake.Quantity,
    Fact_Sales_Snowflake.Sales_Amount

FROM Fact_Sales_Snowflake

JOIN Dim_Product_Snowflake
ON Fact_Sales_Snowflake.Product_ID =
   Dim_Product_Snowflake.Product_ID

JOIN Dim_Category
ON Dim_Product_Snowflake.Category_ID =
   Dim_Category.Category_ID

JOIN Dim_Brand
ON Dim_Product_Snowflake.Brand_ID =
   Dim_Brand.Brand_ID

JOIN Dim_Customer_Snowflake
ON Fact_Sales_Snowflake.Customer_ID =
   Dim_Customer_Snowflake.Customer_ID

JOIN Dim_City
ON Dim_Customer_Snowflake.City_ID =
   Dim_City.City_ID

JOIN Dim_Date_Snowflake
ON Fact_Sales_Snowflake.Date_ID =
   Dim_Date_Snowflake.Date_ID;



