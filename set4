-- Q6: OLAP - STUDENT TABLE
-- =====================================================


DROP TABLE IF EXISTS STUDENT;


-- Create STUDENT table

CREATE TABLE STUDENT (
    Roll_No INT PRIMARY KEY,
    Student_Name VARCHAR(50),
    Department VARCHAR(30),
    City VARCHAR(30),
    Marks INT
);


-- Insert student records

INSERT INTO STUDENT VALUES
(1, 'Rahul', 'IT', 'Pune', 85),
(2, 'Amit', 'Computer', 'Mumbai', 75),
(3, 'Priya', 'IT', 'Nashik', 90),
(4, 'Sneha', 'ENTC', 'Pune', 80),
(5, 'Rohan', 'Computer', 'Mumbai', 65),
(6, 'Neha', 'ENTC', 'Nashik', 95);


-- (A) Display all student records

SELECT * FROM STUDENT;


-- (B) Find maximum marks

SELECT MAX(Marks) AS Maximum_Marks
FROM STUDENT;


-- (C) Calculate department-wise average marks

SELECT
    Department,
    AVG(Marks) AS Average_Marks
FROM STUDENT
GROUP BY Department;


